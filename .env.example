# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# PostgreSQL bootstrap role password is used only to initialize a brand-new cluster.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# A2 least-privilege database roles.
# Runtime is used by the web app; migrator owns the billing database/schema objects.
RUNTIME_DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
MIGRATOR_DB_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_WITH_12_OR_MORE_CHARACTERS
APP_HOST=billing.example.com
