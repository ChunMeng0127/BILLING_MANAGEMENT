# Optional production backup overrides.
# Copy to /etc/billing-control/backup.env and keep it mode 600.

# A2 least-privilege backup role. The role has read-only access to billing data
# and can authenticate only where PostgreSQL host rules allow it.
DB_USER=billing_backup

# Local backup behavior
APPLY_RETENTION=1
BACKUP_DIR=/docker/billing-control/backups
STATUS_DIR=/var/lib/billing-control-backup

# Preferred offsite mode: rclone remote.
# Upload is followed by remote read-back SHA-256 verification.
# Example production target used for A1:
# OFFSITE_RCLONE_REMOTE=billing-m365:BillingControl-Backups
# OFFSITE_RCLONE_CONFIG=/root/.config/rclone/rclone.conf
# OFFSITE_REQUIRED=1
#
# Client-side rclone crypt may be layered on later, but only after its
# decryption key is escrowed outside the VPS so disaster recovery remains possible.

# Alternative offsite mode: separately mounted remote filesystem.
# Do NOT point this to another directory on the same VPS filesystem.
# OFFSITE_DIR=/mnt/billing-control-offsite
# OFFSITE_REQUIRED=1
# OFFSITE_MUST_BE_MOUNT=1
