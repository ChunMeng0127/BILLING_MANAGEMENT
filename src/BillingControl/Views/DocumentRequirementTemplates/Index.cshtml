@model DocumentRequirementTemplateIndexViewModel
@using BillingControl.Services
@{
    ViewData["Title"] = "Document Checklists";
    var groups = Model.Templates.GroupBy(x => new { x.ServiceId, x.ServiceName, x.TemplateKey });
}

<div class="page-heading">
    <div>
        <p class="eyebrow">DOCUMENT COLLECTION</p>
        <h1>Document Checklists</h1>
        <p>Reusable, versioned checklists for staff-managed service document requests.</p>
    </div>
    <a class="btn btn-primary" href="/DocumentRequirementTemplates/Create">+ New checklist</a>
</div>

<form class="report-filters" method="get" action="/DocumentRequirementTemplates">
    <div>
        <label for="ServiceId">Service</label>
        <select id="ServiceId" name="ServiceId" class="form-select">
            <option value="">All services</option>
            @foreach (var service in Model.Services)
            {
                <option value="@service.Id" selected="@(Model.ServiceId == service.Id ? "selected" : null)">@service.Name@(service.IsActive ? "" : " (inactive)")</option>
            }
        </select>
    </div>
    <button class="btn btn-outline-secondary" type="submit">Apply filters</button>
    <a href="/DocumentRequirementTemplates">Reset</a>
</form>

@if (!Model.Templates.Any())
{
    <div class="panel empty-state p-4">
        <h2>No document checklists found</h2>
        <p>Create the first checklist for a service, or clear the service filter to view all checklist history.</p>
        <a class="btn btn-primary" href="/DocumentRequirementTemplates/Create">Create a checklist</a>
    </div>
}
else
{
    @foreach (var group in groups)
    {
        var familyName = group.OrderBy(x => x.TemplateVersion).First().Name;
        <div class="panel">
            <div class="panel-heading">
                <div>
                    <h2>@group.Key.ServiceName <span class="text-muted">· @familyName</span></h2>
                    <p>@group.Count() version@(group.Count() == 1 ? "" : "s") · prior versions remain available for history</p>
                </div>
                <a href="/DocumentRequirementTemplates/Create?serviceId=@group.Key.ServiceId">New checklist</a>
            </div>
            <div class="table-responsive">
                <table class="table data-grid">
                    <thead><tr><th>Service</th><th>Checklist name</th><th>Version</th><th>Default</th><th>Active</th><th>Used</th><th>Documents</th><th data-nosort>Actions</th></tr></thead>
                    <tbody>
                    @foreach (var checklist in group.OrderBy(x => x.TemplateVersion))
                    {
                        <tr>
                            <td>@checklist.ServiceName</td>
                            <td class="fw-semibold">@checklist.Name</td>
                            <td><a href="/DocumentRequirementTemplates/Edit/@checklist.Id">Version @checklist.TemplateVersion</a></td>
                            <td>@(checklist.IsDefault ? "Yes" : "—")</td>
                            <td><span class="badge @(checklist.IsActive ? "status-active" : "status-inactive")">@(checklist.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@(checklist.IsUsed ? "Used" : "Unused")</td>
                            <td>@checklist.ItemCount</td>
                            <td><a href="/DocumentRequirementTemplates/Edit/@checklist.Id">View / edit</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
