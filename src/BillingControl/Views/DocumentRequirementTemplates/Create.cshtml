@model DocumentRequirementTemplateCreateViewModel
@using BillingControl.Services
@{
    ViewData["Title"] = "New document checklist";
    var services = ViewBag.Services as IReadOnlyList<DocumentRequirementTemplateServiceOption> ?? [];
}

<a class="back-link" href="/DocumentRequirementTemplates">← Document Checklists</a>
<div class="page-heading">
    <div>
        <p class="eyebrow">NEW DOCUMENT CHECKLIST</p>
        <h1>Create first version</h1>
        <p>Version 1 is created automatically. Add the documents normally required for this service.</p>
    </div>
</div>

<form asp-action="Create" method="post" class="panel form-panel wide">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-grid">
        <div>
            <label asp-for="ServiceId" class="form-label">Service</label>
            <select asp-for="ServiceId" class="form-select" required>
                <option value="">Select service</option>
                @foreach (var service in services) { <option value="@service.Id">@service.Name@(service.IsActive ? "" : " (inactive)")</option> }
            </select>
        </div>
        <div>
            <label asp-for="Name" class="form-label">Checklist name</label>
            <input asp-for="Name" class="form-control" maxlength="160" required placeholder="Standard Yearly Bookkeeping Documents" />
            <p class="hint">This checklist can be reused for customers using the selected service.</p>
        </div>
        <div>
            <label asp-for="Description" class="form-label">Checklist description <span class="hint">(optional)</span></label>
            <textarea asp-for="Description" class="form-control" rows="2" maxlength="2000" placeholder="Standard documents normally required from clients for yearly bookkeeping."></textarea>
        </div>
    </div>
    <div class="form-grid">
        <label class="form-check form-switch mt-3"><input asp-for="IsActive" class="form-check-input" /><span class="form-check-label">Active</span></label>
        <div>
            <label class="form-check form-switch mt-3"><input asp-for="IsDefault" class="form-check-input" /><span class="form-check-label">Use as default checklist for this service</span></label>
            <p class="hint">This checklist will be selected first when creating a document request for this service.</p>
        </div>
    </div>

    <h2 class="section-title">Initial checklist items</h2>
    <p class="hint">Documents will appear in the order shown below. You can change the order later.</p>
    <p class="hint">Request priority controls when the item should be requested. Required controls whether the item is mandatory.</p>
    <div class="table-responsive">
        <table class="table data-grid template-items-table">
            <thead><tr><th>Document / requirement</th><th>Description</th><th>Required?</th><th>Request priority</th><th>Active?</th><th></th></tr></thead>
            <tbody data-template-rows data-next-index="@Model.Items.Count">
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td><input asp-for="Items[i].Name" class="form-control" maxlength="160" placeholder="Bank Statements" /></td>
                    <td><input asp-for="Items[i].Description" class="form-control" maxlength="2000" placeholder="Full financial year, all bank accounts" /></td>
                    <td class="text-center"><input asp-for="Items[i].IsRequired" class="form-check-input" /></td>
                    <td><select asp-for="Items[i].Wave" class="form-select">@foreach (var wave in Enum.GetValues<DocumentRequirementWave>()) { <option value="@wave">@Finance.Label(wave)</option> }</select></td>
                    <td class="text-center"><input asp-for="Items[i].IsActive" class="form-check-input" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-secondary" data-template-remove-row>Remove</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <button type="button" class="btn btn-outline-secondary" data-template-add-row data-template-target="[data-template-rows]">+ Add document / requirement</button>
    <template id="template-item-prototype">
        <tr>
            <td><input name="Items[__index__].Name" class="form-control" maxlength="160" placeholder="Bank Statements" /></td>
            <td><input name="Items[__index__].Description" class="form-control" maxlength="2000" placeholder="Full financial year, all bank accounts" /></td>
            <td class="text-center"><input name="Items[__index__].IsRequired" value="true" type="checkbox" class="form-check-input" /></td>
            <td><select name="Items[__index__].Wave" class="form-select">@foreach (var wave in Enum.GetValues<DocumentRequirementWave>()) { <option value="@wave">@Finance.Label(wave)</option> }</select></td>
            <td class="text-center"><input name="Items[__index__].IsActive" value="true" type="checkbox" class="form-check-input" checked /></td>
            <td><button type="button" class="btn btn-sm btn-outline-secondary" data-template-remove-row>Remove</button></td>
        </tr>
    </template>
    <div class="form-actions"><button class="btn btn-primary">Create document checklist</button><a class="btn btn-outline-secondary" href="/DocumentRequirementTemplates">Cancel</a></div>
</form>
@section Scripts { <script src="~/js/document-templates.js" asp-append-version="true"></script> }
