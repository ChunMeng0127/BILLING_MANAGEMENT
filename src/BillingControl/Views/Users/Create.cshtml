@model UserForm
@{ ViewData["Title"]="New user"; }<a class="back-link" href="/Users">← User management</a>
<h1>New user</h1>
<form asp-action="Create" method="post" class="panel form-panel">
<div asp-validation-summary="All" class="text-danger">
</div>
<label asp-for="Email" class="form-label">
</label>
<input asp-for="Email" class="form-control" required />
<label asp-for="Password" class="form-label">Initial password</label>
<input asp-for="Password" class="form-control" autocomplete="new-password" minlength="12" required />
<p class="hint">At least 12 characters, including uppercase, lowercase, a number and a symbol. Share securely with the user.</p>
<label asp-for="Role" class="form-label">
</label>
<select asp-for="Role" class="form-select">
@foreach(var role in AppRoles.All) { <option value="@role">@role</option> }
</select>
<p class="hint">Admin and InternalUser must have no entity link. Each external role requires exactly one matching link.</p>
<label asp-for="BusinessPartyId" class="form-label">Accounting firm link</label>
<select asp-for="BusinessPartyId" class="form-select"><option value="">No accounting firm</option>@foreach(BusinessParty x in ViewBag.Firms){<option value="@x.Id">@x.Name</option>}</select>
<label asp-for="ManagerId" class="form-label">Manager link</label>
<select asp-for="ManagerId" class="form-select"><option value="">No manager</option>@foreach(Manager x in ViewBag.Managers){<option value="@x.Id">@x.Name</option>}</select>
<label asp-for="WorkerId" class="form-label">Worker link</label>
<select asp-for="WorkerId" class="form-select"><option value="">No worker</option>@foreach(Worker x in ViewBag.Workers){<option value="@x.Id">@x.Name</option>}</select>
<div class="form-actions">
<button class="btn btn-primary">Create user</button>
</div>
</form>
