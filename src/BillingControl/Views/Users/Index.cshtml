@model List<AppUser>
@{ ViewData["Title"]="User management"; Dictionary<string,string> roles=ViewBag.Roles; List<BusinessParty> firms=ViewBag.Firms; List<Manager> managers=ViewBag.Managers; List<Worker> workers=ViewBag.Workers; }
<div class="page-heading">
<div>
<p class="eyebrow">ADMINISTRATION</p>
<h1>User management</h1>
<p>Control role and entity scope. Only administrators manage access and cancellations.</p>
</div>
<a class="btn btn-primary" href="/Users/Create">+ New user</a>
</div>
<div class="panel">
<table class="table data-grid">
<thead>
<tr>
<th>Email</th>
<th>Role</th>
<th>Linked entity</th>
<th>Status</th>
<th data-nosort>Access</th>
<th data-nosort>Password reset</th>
</tr>
</thead>
<tbody>
@foreach(var u in Model) { <tr>
<td>@u.Email</td>
<td>@roles[u.Id]</td>
<td>@(u.BusinessParty?.Name ?? u.Manager?.Name ?? u.Worker?.Name ?? "—")</td>
<td><span class="badge @(u.IsActive ? "status-active" : "status-disabled")">@(u.IsActive ? "Active" : "Disabled") @(u.LockoutEnd > DateTimeOffset.UtcNow ? "· Temporarily locked" : "")</span></td>
<td>
<form asp-action="Update" method="post" class="inline-form user-access-form">
<input type="hidden" name="id" value="@u.Id" />
<select name="role" aria-label="Role for @u.Email" class="form-select form-select-sm">
@foreach(var role in AppRoles.All) { <option value="@role" selected="@(roles[u.Id]==role)">@role</option> }
</select>
<select name="businessPartyId" aria-label="Accounting firm link for @u.Email" class="form-select form-select-sm"><option value="">No firm</option>@foreach(var x in firms){<option value="@x.Id" selected="@(u.BusinessPartyId==x.Id)">@x.Name</option>}</select>
<select name="managerId" aria-label="Manager link for @u.Email" class="form-select form-select-sm"><option value="">No manager</option>@foreach(var x in managers){<option value="@x.Id" selected="@(u.ManagerId==x.Id)">@x.Name</option>}</select>
<select name="workerId" aria-label="Worker link for @u.Email" class="form-select form-select-sm"><option value="">No worker</option>@foreach(var x in workers){<option value="@x.Id" selected="@(u.WorkerId==x.Id)">@x.Name</option>}</select>
<label>
<input type="checkbox" name="active" value="true" checked="@u.IsActive" /> Active</label>
<button class="btn btn-outline-secondary btn-sm">Save access</button>
</form>
</td>
<td>
<details>
<summary>Reset password</summary>
<form asp-action="ResetPassword" method="post" class="user-password-reset-form">
<input type="hidden" name="id" value="@u.Id" />
<input type="password" name="password" aria-label="New password for @u.Email" autocomplete="new-password" minlength="12" required class="form-control form-control-sm" />
<button class="btn btn-outline-secondary btn-sm">Reset & unlock</button>
</form>
</details>
</td>
</tr> }
</tbody>
</table>
</div>
