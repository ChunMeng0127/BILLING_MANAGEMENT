@model List<Engagement>
@{ ViewData["Title"] = "Engagements"; AccessProfile access=ViewBag.Access; }
<div class="page-heading">
<div>
<p class="eyebrow">CUSTOMER SERVICES</p>
<h1>Engagements</h1>
<p>Agreed fees, service schedules and revenue-sharing terms.</p>
</div>
@if(access.IsStaff) { <a class="btn btn-primary" href="/Engagements/Edit">+ New engagement</a> }
</div>
<div class="panel">
<table class="table data-grid">
<thead>
<tr>
<th>Customer</th>
<th>Service</th>
<th>Frequency</th>
<th data-type="amount">Fee (RM)</th>
<th>@(access.IsStaff ? "Firm / Manager / LCM %" : access.IsAccountingFirm ? "Your firm %" : "Your manager %")</th>
<th>Status</th>
<th data-type="date">Start</th>
<th data-type="date">End</th>
@if(access.IsStaff) { <th data-nosort>Action</th> }
</tr>
</thead>
<tbody>
@foreach (var e in Model) { <tr>
<td class="fw-semibold">@e.Customer.Name</td>
<td>@e.Service.Name</td>
<td>@Finance.Label(e.Schedule.Frequency)</td>
<td class="money">@e.BillingAmount.ToString("N2")</td>
<td>@if(access.IsStaff){ @($"{e.FirmPercent:0.####} / {e.ManagerPercent:0.####} / {e.LcmPercent:0.####}") } else if(access.IsAccountingFirm){ @e.FirmPercent.ToString("0.####") } else { @e.ManagerPercent.ToString("0.####") }</td>
<td>
<span class="badge status-active">@Finance.Label(e.Status)</span>
</td>
<td>@e.StartDate.ToString("yyyy-MM-dd")</td>
<td>@e.EndDate?.ToString("yyyy-MM-dd")</td>
@if(access.IsStaff) { <td>
<a href="/Engagements/Edit/@e.Id">Edit</a>
<a class="ms-2" href="/Billing/EditSchedule/@e.Id">Edit schedule</a>
</td> }
</tr> }
</tbody>
</table>
</div>
