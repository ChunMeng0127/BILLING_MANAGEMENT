@using BillingControl.Services
@{
    var path = Context.Request.Path.Value ?? "/";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isOverview = path == "/" || path.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase);
    var isBilling = path.StartsWith("/Billing", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Invoices", StringComparison.OrdinalIgnoreCase);
    var isWork = path.StartsWith("/Work", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Payments", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Progress", StringComparison.OrdinalIgnoreCase);
    var isDocuments = path.StartsWith("/Document", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Contacts", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/WhatsAppConversations", StringComparison.OrdinalIgnoreCase);
    var isMasters = path.StartsWith("/Masters", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Engagements", StringComparison.OrdinalIgnoreCase);
    var isAdministration = path.StartsWith("/Users", StringComparison.OrdinalIgnoreCase);
    var navLabel = isOverview ? "Overview" : isBilling ? "Billing" : isWork ? "Work management" : isDocuments ? "Documents & communication" : isMasters ? "Master data" : isAdministration ? "Administration" : "Workspace";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Billing Control</title>
    <meta name="theme-color" content="#152331" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isAuthenticated ? "app-body" : "auth-body")">
    @if (isAuthenticated)
    {
        <div class="app-shell" data-app-shell>
            <aside class="app-sidebar" id="primary-navigation" aria-label="Primary navigation">
                <div class="brand-block">
                    <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="Billing Control home">
                        <span class="brand-mark" aria-hidden="true"></span>
                        <span>
                            <strong>Billing Control</strong>
                            <small>Accounting control room</small>
                        </span>
                    </a>
                    <button class="icon-button sidebar-close" type="button" data-sidebar-toggle aria-label="Close navigation">
                        <span class="close-mark" aria-hidden="true"></span>
                    </button>
                </div>

                <nav class="nav-groups">
                    <div class="nav-group">
                        <p class="nav-group-title">Overview</p>
                        <a class="nav-item @(isOverview ? "is-active" : "")" href="/" aria-current="@(isOverview ? "page" : null)"><span class="nav-mark" aria-hidden="true"></span><span>Dashboard</span></a>
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.AccountingFirm) || User.IsInRole(AppRoles.Manager))
                        {
                            <a class="nav-item @(path.StartsWith("/Billing/Schedule", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Billing/Schedule"><span class="nav-mark" aria-hidden="true"></span><span>Upcoming Billing</span></a>
                            <a class="nav-item @(path.Equals("/Billing", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/Billing/Index", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Billing"><span class="nav-mark" aria-hidden="true"></span><span>Billing Records</span></a>
                            <a class="nav-item @(path.StartsWith("/Invoices", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/Invoices/Receipt", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Invoices"><span class="nav-mark" aria-hidden="true"></span><span>Invoices</span></a>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser))
                        {
                            <a class="nav-item @(path.StartsWith("/Invoices/Receipt", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Invoices/Receipt"><span class="nav-mark" aria-hidden="true"></span><span>Receipts</span></a>
                        }
                    </div>

                    <div class="nav-group">
                        <p class="nav-group-title">Work management</p>
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Worker))
                        {
                            <a class="nav-item @(path.StartsWith("/Work", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/Work/Assignments", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Work"><span class="nav-mark" aria-hidden="true"></span><span>Work Items</span></a>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Worker))
                        {
                            <a class="nav-item @(path.StartsWith("/Work/Assignments", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Work/Assignments"><span class="nav-mark" aria-hidden="true"></span><span>Worker Assignments</span></a>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.Worker))
                        {
                            <a class="nav-item @(path.StartsWith("/Payments", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Payments"><span class="nav-mark" aria-hidden="true"></span><span>Worker Payments</span></a>
                        }
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Worker))
                        {
                            <a class="nav-item @(path.StartsWith("/Progress", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Progress"><span class="nav-mark" aria-hidden="true"></span><span>Weekly Progress</span></a>
                        }
                    </div>

                    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser))
                    {
                        <div class="nav-group">
                            <p class="nav-group-title">Documents &amp; communication</p>
                            <a class="nav-item @(path.StartsWith("/DocumentRequirementTemplates", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/DocumentRequirementTemplates"><span class="nav-mark" aria-hidden="true"></span><span>Document Checklists</span></a>
                            <a class="nav-item @(path.StartsWith("/Contacts", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Contacts"><span class="nav-mark" aria-hidden="true"></span><span>Contacts / PIC</span></a>
                            <a class="nav-item @(path.StartsWith("/WhatsAppConversations", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/WhatsAppConversations"><span class="nav-mark" aria-hidden="true"></span><span>WhatsApp Conversations</span></a>
                        </div>
                    }

                    <div class="nav-group">
                        <p class="nav-group-title">Master data</p>
                        @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser) || User.IsInRole(AppRoles.AccountingFirm) || User.IsInRole(AppRoles.Manager))
                        {
                            <a class="nav-item @(Context.Request.Query["kind"] == "Customers" ? "is-active" : "")" href="/Masters?kind=Customers"><span class="nav-mark" aria-hidden="true"></span><span>Customers</span></a>
                            <a class="nav-item @(Context.Request.Query["kind"] == "Services" ? "is-active" : "")" href="/Masters?kind=Services"><span class="nav-mark" aria-hidden="true"></span><span>Services</span></a>
                            <a class="nav-item @(Context.Request.Query["kind"] == "Firms" ? "is-active" : "")" href="/Masters?kind=Firms"><span class="nav-mark" aria-hidden="true"></span><span>Accounting Firms</span></a>
                            <a class="nav-item @(Context.Request.Query["kind"] == "Managers" ? "is-active" : "")" href="/Masters?kind=Managers"><span class="nav-mark" aria-hidden="true"></span><span>Managers</span></a>
                            <a class="nav-item @(Context.Request.Query["kind"] == "Workers" ? "is-active" : "")" href="/Masters?kind=Workers"><span class="nav-mark" aria-hidden="true"></span><span>Workers</span></a>
                            <a class="nav-item @(path.StartsWith("/Engagements", StringComparison.OrdinalIgnoreCase) ? "is-active" : "")" href="/Engagements"><span class="nav-mark" aria-hidden="true"></span><span>Engagements</span></a>
                        }
                    </div>

                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <div class="nav-group">
                            <p class="nav-group-title">Administration</p>
                            <a class="nav-item @(isAdministration ? "is-active" : "")" href="/Users"><span class="nav-mark" aria-hidden="true"></span><span>User Management</span></a>
                        </div>
                    }
                </nav>

                <div class="sidebar-footer">
                    <span class="workspace-status"><span class="status-dot is-positive" aria-hidden="true"></span>Internal workspace</span>
                    <small>Access follows your assigned role.</small>
                </div>
            </aside>

            <button class="sidebar-scrim" type="button" data-sidebar-scrim aria-label="Close navigation"></button>

            <div class="app-main">
                <header class="topbar">
                    <div class="topbar-leading">
                        <button class="icon-button sidebar-open" type="button" data-sidebar-toggle aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation">
                            <span class="menu-mark" aria-hidden="true"></span>
                        </button>
                        <span class="topbar-context">@navLabel</span>
                    </div>
                    <div class="topbar-actions">
                        <span class="role-label">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Workspace user")</span>
                        <details class="account-menu">
                            <summary class="account-trigger"><span class="account-avatar" aria-hidden="true">@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "U")</span><span class="account-name">@User.Identity?.Name</span><span class="chevron" aria-hidden="true"></span></summary>
                            <div class="account-panel">
                                <a href="/Account/Password">Change password</a>
                                <form method="post" action="/Account/Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit">Sign out</button>
                                </form>
                            </div>
                        </details>
                    </div>
                </header>

                @if (TempData["Success"] is string success)
                {
                    <div class="flash-message is-success" role="status">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="flash-message is-error" role="alert">@error</div>
                }
                @if (TempData["Info"] is string info)
                {
                    <div class="flash-message is-info" role="status">@info</div>
                }

                <main class="page-content @ViewData["ContentClass"]">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main class="auth-frame">
            @RenderBody()
        </main>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
