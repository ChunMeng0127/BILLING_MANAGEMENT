<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Billing Control</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{ var staff = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser); var firm = User.IsInRole(AppRoles.AccountingFirm); var manager = User.IsInRole(AppRoles.Manager); var worker = User.IsInRole(AppRoles.Worker); }
@if (User.Identity?.IsAuthenticated == true) {
<aside class="sidebar">
<a class="brand" href="/">
<span class="brand-mark">bc</span>
<span>Billing Control<small>LCM MGT · Workspace</small>
</span>
</a>
<div class="nav-label">WORKSPACE</div>
<nav>
<a class="@(Context.Request.Path.Value == "/" ? "active" : "")" href="/">Overview</a>
@if (staff || firm || manager) { <a class="@(Context.Request.Path.Value == "/Billing/Schedule" ? "active" : "")" href="/Billing/Schedule">Upcoming billing</a><a class="@(Context.Request.Path.Value == "/Billing" ? "active" : "")" href="/Billing">Billing records</a> }
@if (staff || firm || manager) { <a class="@(Context.Request.Path.Value?.StartsWith("/Invoices") == true ? "active" : "")" href="/Invoices">Invoices</a> }
@if (staff || manager || worker) { <a class="@(Context.Request.Path.Value == "/Work" ? "active" : "")" href="/Work">Work items</a> }
@if (staff || manager || worker) { <a class="@(Context.Request.Path.Value?.StartsWith("/Progress") == true ? "active" : "")" href="/Progress">Weekly progress</a> }
@if (staff || worker) { <a class="@(Context.Request.Path.Value == "/Work/Assignments" ? "active" : "")" href="/Work/Assignments">Worker assignments</a><a class="@(Context.Request.Path.Value == "/Payments" ? "active" : "")" href="/Payments">Worker payments</a> }
<a class="@(Context.Request.Path.Value == "/Home/Reports" ? "active" : "")" href="/Home/Reports">Reports</a>
</nav>
<div class="nav-label">DIRECTORY</div>
<nav>
@if (staff) { @foreach (var kind in new[] { "Customers", "Services", "Firms", "Managers", "Workers" }) { <a href="/Masters?kind=@kind">@(kind == "Firms" ? "Accounting firms" : kind)</a> } }
@if (firm || manager) { <a href="/Masters?kind=Customers">Customers</a><a href="/Masters?kind=Services">Services</a> }
@if (staff || firm || manager) { <a href="/Engagements">Engagements</a> }
@if (User.IsInRole(AppRoles.Admin)) { <a href="/Users">User management</a> }
</nav>
<div class="sidebar-foot">
<span class="live-dot">
</span> Internal accounting workspace</div>
</aside>
<div class="app-shell">
<header class="topbar">
<span>Accounting operations <span class="text-muted">/ @ViewData["Title"]</span>
</span>
<div class="account">
<a href="/Account/Password">@User.Identity.Name</a>
<form asp-controller="Account" asp-action="Logout" method="post">
<button class="btn btn-sm btn-outline-secondary">Sign out</button>
</form>
</div>
</header>
<main>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@RenderBody()</main>
<footer>Billing Control <span>MYR · Financial records retain their original snapshots</span>
</footer>
</div>
} else { <main class="login-shell">@RenderBody()</main> }
<script src="~/js/site.js" asp-append-version="true">
</script>@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
