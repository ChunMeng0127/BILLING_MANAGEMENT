@model ReportModel
<div class="metrics">
@if (Model.Access.IsStaff) {
@foreach (var m in new[] { ("Customer billing", Model.Total, "All active service periods"), ("Accounting firm share", Model.Share(ShareKind.Firm), "Historical allocation"), ("Manager retained share", Model.ManagerRetained, "Gross margin before manager operating costs"), ("LCM MGT gross share", Model.Share(ShareKind.Lcm), "Manager cost / LCM sales"), ("Manager billable sales", Model.ManagerSales, "Manager + LCM portions"), ("Manager invoiced", Model.ManagerInvoiced, "Active Manager → Accounting Firm invoices"), ("LCM → Manager invoiced", Model.LcmInvoicedToManager, "Active LCM invoices"), ("Worker entitlement", Model.WorkerCost, "Agreed assignment costs"), ("LCM MGT retained", Model.Share(ShareKind.Lcm)-Model.WorkerCost, "Gross share less entitlement"), ("Billing outstanding", Model.BillingOutstanding, "Posted bills less receipts"), ("Worker payments due", Model.WorkerCost-Model.WorkerPaid, "Entitlements less payments") }) { <div class="metric"><span>@m.Item1</span><strong><small>RM</small> @m.Item2.ToString("N2")</strong><p>@m.Item3</p></div> }
} else if (Model.Access.IsAccountingFirm) {
@foreach (var m in new[] { ("Customer billing", Model.Total, "Your customer service periods"), ("Your firm share", Model.OwnShare, "Historical allocation"), ("Billing outstanding", Model.BillingOutstanding, "Posted bills less receipts") }) { <div class="metric"><span>@m.Item1</span><strong><small>RM</small> @m.Item2.ToString("N2")</strong><p>@m.Item3</p></div> }
} else if (Model.Access.IsManager) {
@foreach (var m in new[] { ("Customer billing", Model.Total, "Your managed service periods"), ("Manager sales", Model.ManagerSales, "Manager + LCM portions billed to accounting firms"), ("LCM cost", Model.ManagerLcmCost, "LCM MGT portion payable by manager"), ("Gross margin", Model.ManagerRetained, "Manager sales less LCM cost"), ("Manager invoiced", Model.ManagerInvoiced, "Active Manager → Accounting Firm invoices"), ("Manager unbilled", Model.ManagerUnbilled, "Remaining manager sales entitlement") }) { <div class="metric"><span>@m.Item1</span><strong><small>RM</small> @m.Item2.ToString("N2")</strong><p>@m.Item3</p></div> }
} else if (Model.Access.IsWorker) {
@foreach (var m in new[] { ("Your entitlement", Model.WorkerCost, "Active assigned work"), ("Paid to you", Model.WorkerPaid, "Recorded payment allocations"), ("Due to you", Model.WorkerCost-Model.WorkerPaid, "Entitlement less payments") }) { <div class="metric"><span>@m.Item1</span><strong><small>RM</small> @m.Item2.ToString("N2")</strong><p>@m.Item3</p></div> }
}
</div>
