@using BillingControl.Models
@using BillingControl.Services
@using Microsoft.AspNetCore.Mvc.Rendering
@model ReportModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["ContentClass"] = "dashboard-page";
    var isWorker = Model.Access.Role == AppRoles.Worker;
    var isManager = Model.Access.Role == AppRoles.Manager;
    var hasAttention = Model.ProgressMissing > 0 || Model.ProgressLate > 0 || (!isWorker && Model.ManagerUnbilled > 0) || (!isWorker && Model.BillingOutstanding > 0) || Model.Bills.Count == 0;
    var customers = ViewBag.Customers as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
    var services = ViewBag.Services as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
    var workers = ViewBag.Workers as IEnumerable<SelectListItem> ?? Array.Empty<SelectListItem>();
}

<div class="page-heading">
    <div>
        <h1>Accounting control room</h1>
        <p class="page-summary">A focused view of upcoming billing, open work, and the records that need your attention.</p>
    </div>
    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser))
    {
        <div class="page-actions">
            <a class="button button-primary" href="/Engagements/Edit">New engagement</a>
            <a class="button button-quiet" href="/Home/Reports">Open reports</a>
        </div>
    }
</div>

<section class="sheet attention-register" aria-labelledby="attention-title">
    <div class="sheet-heading attention-heading">
        <div>
            <div class="section-heading-line">
                <span class="section-signal" aria-hidden="true"></span>
                <h2 id="attention-title">Needs attention</h2>
            </div>
            <p class="section-summary">Start here. Each row points to the next operational decision.</p>
        </div>
        <span class="attention-count">@(Model.ProgressMissing + Model.ProgressLate + ((!isWorker && Model.ManagerUnbilled > 0) ? 1 : 0) + ((!isWorker && Model.BillingOutstanding > 0) ? 1 : 0)) open</span>
    </div>

    @if (hasAttention)
    {
        <div class="attention-list">
            @if (Model.ProgressMissing > 0)
            {
                <a class="attention-row" href="/Progress?filter=Active">
                    <span class="attention-state is-warning" aria-hidden="true"></span>
                    <span class="attention-copy"><strong>@Model.ProgressMissing progress reports missing</strong><small>Review active assignments that still require this week’s update.</small></span>
                    <span class="row-action">Review progress <span class="arrow-mark" aria-hidden="true"></span></span>
                </a>
            }
            @if (Model.ProgressLate > 0)
            {
                <a class="attention-row" href="/Progress?filter=Active">
                    <span class="attention-state is-danger" aria-hidden="true"></span>
                    <span class="attention-copy"><strong>@Model.ProgressLate progress reports late</strong><small>Follow up on submitted reports that missed the reporting window.</small></span>
                    <span class="row-action">Review progress <span class="arrow-mark" aria-hidden="true"></span></span>
                </a>
            }
            @if (!isWorker && Model.ManagerUnbilled > 0)
            {
                <a class="attention-row" href="/Invoices">
                    <span class="attention-state is-copper" aria-hidden="true"></span>
                    <span class="attention-copy"><strong>@Model.ManagerUnbilled.ToString("C", System.Globalization.CultureInfo.CurrentCulture) manager sales capacity unbilled</strong><small>Check invoice coverage before the next billing run.</small></span>
                    <span class="row-action">Open invoices <span class="arrow-mark" aria-hidden="true"></span></span>
                </a>
            }
            @if (!isWorker && Model.BillingOutstanding > 0)
            {
                <a class="attention-row" href="/Invoices">
                    <span class="attention-state is-danger" aria-hidden="true"></span>
                    <span class="attention-copy"><strong>@Model.BillingOutstanding.ToString("C", System.Globalization.CultureInfo.CurrentCulture) customer balance outstanding</strong><small>Review receipt allocation and outstanding customer invoices.</small></span>
                    <span class="row-action">Review invoices <span class="arrow-mark" aria-hidden="true"></span></span>
                </a>
            }
            @if (Model.Bills.Count == 0)
            {
                <div class="attention-row attention-row-static">
                    <span class="attention-state is-neutral" aria-hidden="true"></span>
                    <span class="attention-copy"><strong>No billing records match the current view</strong><small>Clear or adjust the filters below to widen the working set.</small></span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-register"><span class="empty-mark" aria-hidden="true"></span><strong>No open exceptions</strong><span>The current workspace is clear for the selected period.</span></div>
    }

    <div class="register-footer">
        <span><strong>@Model.ProgressSubmitted</strong> of <strong>@Model.ProgressRequired</strong> required progress reports submitted</span>
        <a href="/Progress">Open weekly progress <span class="arrow-mark" aria-hidden="true"></span></a>
    </div>
</section>

<div class="dashboard-tools">
    <details class="surface-disclosure">
        <summary><span><strong>Filter working set</strong><small>Customer, service, worker, status, or period</small></span><span class="disclosure-toggle">Adjust <span class="chevron" aria-hidden="true"></span></span></summary>
        <form class="filter-form" method="get" action="/">
            <div class="form-field">
                <label for="CustomerId">Customer</label>
                <select id="CustomerId" name="CustomerId">
                    <option value="">All customers</option>
                    @foreach (var item in customers)
                    {
                        <option value="@item.Value" selected="@(Model.Filter.CustomerId?.ToString() == item.Value ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label for="ServiceId">Service</label>
                <select id="ServiceId" name="ServiceId">
                    <option value="">All services</option>
                    @foreach (var item in services)
                    {
                        <option value="@item.Value" selected="@(Model.Filter.ServiceId?.ToString() == item.Value ? "selected" : null)">@item.Text</option>
                    }
                </select>
            </div>
            @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.InternalUser))
            {
                <div class="form-field">
                    <label for="WorkerId">Worker</label>
                    <select id="WorkerId" name="WorkerId">
                        <option value="">All workers</option>
                        @foreach (var item in workers)
                        {
                            <option value="@item.Value" selected="@(Model.Filter.WorkerId?.ToString() == item.Value ? "selected" : null)">@item.Text</option>
                        }
                    </select>
                </div>
            }
            <div class="form-field">
                <label for="Status">Billing status</label>
                <select id="Status" name="Status">
                    <option value="">All statuses</option>
                    @foreach (var status in Enum.GetValues<BillingStatus>())
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status ? "selected" : null)">@Finance.Label(status)</option>
                    }
                </select>
            </div>
            <div class="form-field">
                <label for="From">From</label>
                <input id="From" name="From" type="date" value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="form-field">
                <label for="To">To</label>
                <input id="To" name="To" type="date" value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="filter-actions">
                <button class="button button-primary" type="submit">Apply filters</button>
                <a class="button button-quiet" href="/">Clear</a>
            </div>
        </form>
    </details>

    <details class="surface-disclosure">
        <summary><span><strong>Financial summary</strong><small>Role-scoped totals for the current working set</small></span><span class="disclosure-toggle">View totals <span class="chevron" aria-hidden="true"></span></span></summary>
        <div class="metric-register">
            <div class="metric-line"><span>Active billing records</span><strong>@Model.Active.Count()</strong></div>
            @if (!isWorker)
            {
                <div class="metric-line"><span>Billing value</span><strong>@Model.Total.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
                <div class="metric-line"><span>Customer outstanding</span><strong>@Model.BillingOutstanding.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
            }
            @if (isManager)
            {
                <div class="metric-line"><span>Manager sales</span><strong>@Model.ManagerSales.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
                <div class="metric-line"><span>Manager invoiced</span><strong>@Model.ManagerInvoiced.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
                <div class="metric-line"><span>Manager unbilled</span><strong>@Model.ManagerUnbilled.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
            }
            @if (isWorker)
            {
                <div class="metric-line"><span>Worker entitlement</span><strong>@Model.WorkerCost.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
                <div class="metric-line"><span>Worker paid</span><strong>@Model.WorkerPaid.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</strong></div>
            }
        </div>
    </details>
</div>

<div class="dashboard-lanes">
    @if (!isWorker)
    {
        <section class="sheet working-sheet" aria-labelledby="upcoming-title">
            <div class="sheet-heading">
                <div>
                    <h2 id="upcoming-title">Upcoming billing</h2>
                    <p class="section-summary">The next scheduled periods in your accessible working set.</p>
                </div>
                <a class="text-link" href="/Billing/Schedule">View schedule <span class="arrow-mark" aria-hidden="true"></span></a>
            </div>
            @if (Model.Upcoming.Count > 0)
            {
                <div class="data-grid-wrap">
                    <table class="data-grid">
                        <thead><tr><th scope="col">Customer</th><th scope="col">Service</th><th scope="col">Next period</th><th scope="col">Frequency</th></tr></thead>
                        <tbody>
                        @foreach (var schedule in Model.Upcoming)
                        {
                            <tr>
                                <td><a class="table-link" href="/Billing/Schedule">@schedule.Engagement.Customer.Name</a></td>
                                <td>@schedule.Engagement.Service.Name</td>
                                <td class="numeric">@schedule.NextPeriodStart?.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge is-info">@Finance.Label(schedule.Frequency)</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="sheet-empty"><strong>No upcoming billing periods</strong><span>Scheduled billing will appear here when an active engagement has a next period.</span></div>
            }
        </section>
    }
    else
    {
        <section class="sheet working-sheet" aria-labelledby="assigned-title">
            <div class="sheet-heading">
                <div>
                    <h2 id="assigned-title">Assigned work</h2>
                    <p class="section-summary">Your current billing records and delivery status.</p>
                </div>
                <a class="text-link" href="/Work/Assignments">View assignments <span class="arrow-mark" aria-hidden="true"></span></a>
            </div>
            @if (Model.Bills.Count > 0)
            {
                <div class="data-grid-wrap">
                    <table class="data-grid">
                        <thead><tr><th scope="col">Customer</th><th scope="col">Period</th><th scope="col">Billing</th><th scope="col">Work</th></tr></thead>
                        <tbody>
                        @foreach (var bill in Model.Bills.Take(6))
                        {
                            <tr>
                                <td><a class="table-link" href="/Work/Details/@bill.Id">@bill.CustomerName</a><small class="table-subtext">@bill.ServiceName</small></td>
                                <td class="numeric">@bill.PeriodStart.ToString("dd MMM") – @bill.PeriodEnd.ToString("dd MMM yyyy")</td>
                                <td><span class="status-badge is-neutral">@Finance.Label(bill.Status)</span></td>
                                <td><span class="status-badge @(bill.WorkItem.Status == WorkStatus.Completed ? "is-positive" : bill.WorkItem.Status == WorkStatus.InProgress ? "is-info" : "is-warning")">@Finance.Label(bill.WorkItem.Status)</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="sheet-empty"><strong>No assigned work in this view</strong><span>New assignments will appear here when they are available.</span></div>
            }
        </section>
    }

    <section class="sheet working-sheet" aria-labelledby="flow-title">
        <div class="sheet-heading">
            <div>
                <h2 id="flow-title">Billing flow</h2>
                <p class="section-summary">A compact read on where active records sit.</p>
            </div>
            <a class="text-link" href="/Billing">Open records <span class="arrow-mark" aria-hidden="true"></span></a>
        </div>
        <div class="status-register">
            @foreach (var status in Enum.GetValues<BillingStatus>().Where(x => x != BillingStatus.Cancelled))
            {
                var count = Model.Active.Count(x => x.Status == status);
                if (count > 0)
                {
                    <a class="status-line" href="/Billing?Status=@status"><span class="status-badge @(status == BillingStatus.Paid ? "is-positive" : status == BillingStatus.PartiallyPaid ? "is-info" : status == BillingStatus.ReadyToBill ? "is-copper" : status == BillingStatus.WorkInProgress ? "is-warning" : "is-neutral")">@Finance.Label(status)</span><strong>@count</strong><span class="arrow-mark" aria-hidden="true"></span></a>
                }
            }
            @if (!Model.Active.Any())
            {
                <div class="sheet-empty compact"><strong>No active billing records</strong><span>Try widening the filters.</span></div>
            }
        </div>
    </section>
</div>
