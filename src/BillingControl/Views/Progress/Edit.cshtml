@model WeeklyProgressForm
@{ ViewData["Title"] = Model.Id > 0 ? "Edit weekly update" : "Submit weekly update"; WorkerAssignment assignment = ViewBag.Assignment; var nextQueries = (int?)ViewBag.NextQueriesVersion ?? 1; var nextDraft = (int?)ViewBag.NextDraftVersion ?? 1; }
<a class="back-link" href="/Progress?weekStart=@Model.WeekStart.ToString("yyyy-MM-dd")">← Worker assignments</a>
<div class="page-heading"><div><p class="eyebrow">@ViewData["Title"]</p><h1>@assignment.WorkItem.BillingRecord.CustomerName</h1><p>@assignment.WorkItem.BillingRecord.ServiceName · A-@assignment.Id.ToString("D5") · @assignment.Percent.ToString("0.##")% assigned</p></div></div>
<div class="panel form-panel wide"><p class="hint">Reporting week: @Model.WeekStart.ToString("dd MMM yyyy") — @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy"). A worker editing the current-week report also updates the assignment's current workflow state; staff corrections to historical reports preserve that current state.</p>
<form method="post" asp-action="Save" data-workflow-form data-next-queries-version="@nextQueries" data-next-draft-version="@nextDraft">
<div asp-validation-summary="All" class="text-danger"></div>
<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Version" /><input type="hidden" asp-for="WorkerAssignmentId" /><input type="hidden" asp-for="AssignmentVersion" /><input type="hidden" asp-for="WeekStart" />
<label class="form-label">Workflow status<select asp-for="WorkflowStatus" class="form-select" data-workflow-status required>@foreach (var s in Enum.GetValues<WorkflowStatus>()) { <option value="@s">@Finance.Label(s)</option> }</select></label>
<label class="form-label" data-workflow-version-container hidden>Workflow version<input asp-for="WorkflowVersion" type="number" min="1" step="1" class="form-control" data-workflow-version-input /><span class="hint">Version is required for Queries Sent and Draft Management Report Sent.</span></label>
<label class="form-label">Progress percent<input asp-for="ProgressPercent" type="number" min="0" max="100" step="0.01" class="form-control" required /></label>
<label class="form-label">Work done<textarea asp-for="WorkDone" class="form-control" rows="5" maxlength="4000" required></textarea></label>
<label class="form-label">Next action<textarea asp-for="NextAction" class="form-control" rows="3" maxlength="2000"></textarea><span class="hint">Required unless workflow status is Completed.</span></label>
<label class="form-label">Issues / blockers<textarea asp-for="IssuesOrBlockers" class="form-control" rows="3" maxlength="2000"></textarea></label>
<div class="form-actions"><button class="btn btn-primary">@(Model.Id > 0 ? "Save changes" : "Submit weekly update")</button><a class="btn btn-outline-secondary" href="/Progress?weekStart=@Model.WeekStart.ToString("yyyy-MM-dd")">Cancel</a></div>
</form></div>
