@{ ViewData["Title"] = "Change password"; }<h1>Change password</h1>
<form method="post" asp-action="Password" class="panel form-panel">
<div asp-validation-summary="All" class="text-danger">
</div>
<label class="form-label" for="current">Current password</label>
<input id="current" name="currentPassword" type="password" class="form-control" autocomplete="current-password" required />
<label class="form-label" for="new">New password</label>
<input id="new" name="newPassword" type="password" class="form-control" autocomplete="new-password" minlength="12" required />
<p class="hint">At least 12 characters, including uppercase, lowercase, a number and a symbol.</p>
<button class="btn btn-primary">Update password</button>
</form>