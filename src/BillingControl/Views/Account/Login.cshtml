@model LoginForm
@{ ViewData["Title"] = "Sign in"; }
<div class="login-card">
    <div class="login-brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <p class="eyebrow">LCM MGT WORKSPACE</p>
    </div>
    <h1>Welcome back.</h1>
    <p class="login-intro">Sign in to manage your work and billing.</p>
    <form method="post" asp-action="Login">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="login-field">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" required />
        </div>
        <div class="login-field">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" required />
        </div>
        <label class="check-line">
            <input asp-for="RememberMe" />
            <span>Remember me</span>
        </label>
        <button class="button button-primary login-submit" type="submit">Sign in</button>
    </form>
    <p class="login-note">Need access? Contact your workspace administrator.</p>
</div>
