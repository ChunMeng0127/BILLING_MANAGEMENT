@model MasterForm
@{ string kind = ViewBag.Kind; ViewData["Title"] = (Model.Id == 0 ? "Add " : "Edit ") + kind; }
<a class="back-link" href="/Masters?kind=@kind">← @kind</a>
<h1>@ViewData["Title"]</h1>
<form method="post" asp-action="Edit" asp-route-kind="@kind" class="panel form-panel">
<div asp-validation-summary="All" class="text-danger">
</div>
<input asp-for="Id" type="hidden" />
<input asp-for="Version" type="hidden" />
<label asp-for="Name" class="form-label">
</label>
<input asp-for="Name" class="form-control" required maxlength="160" />
@if (kind is "Customers" or "Workers") { <label asp-for="Email" class="form-label">
</label>
<input asp-for="Email" class="form-control" /> }
@if (kind == "Customers") { <label asp-for="RegistrationNumber" class="form-label">Registration number</label>
<input asp-for="RegistrationNumber" class="form-control" /> }
@if (kind == "Workers") { <label asp-for="Type" class="form-label">Worker type</label>
<select asp-for="Type" asp-items="Html.GetEnumSelectList<WorkerType>()" class="form-select">
</select> }
<label asp-for="Notes" class="form-label">
</label>
<textarea asp-for="Notes" class="form-control" rows="3">
</textarea>
<label class="check-line">
<input asp-for="IsActive" /> Active</label>
<div class="form-actions">
<button class="btn btn-primary">Save record</button>
<a class="btn btn-outline-secondary" href="/Masters?kind=@kind">Cancel</a>
</div>
</form>