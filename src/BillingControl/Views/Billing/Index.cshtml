@model List<BillingRecord>
@{ ViewData["Title"] = "Billing records"; ReportFilter f = ViewBag.Filter; AccessProfile access = ViewBag.Access; var showReceipts = access.IsStaff || access.IsAccountingFirm; }
<div class="page-heading">
<div>
<p class="eyebrow">BILLING REGISTER</p>
<h1>Billing records</h1>
<p>Service periods, invoice documents and customer balances.</p>
</div>
@if (access.IsStaff) { <a href="/Billing/Schedule" class="btn btn-primary">+ Generate billing</a> }
</div>
<form class="report-filters" method="get">
<div>
<label for="from">Service period from</label>
<input id="from" name="From" type="date" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" />
</div>
<div>
<label for="to">Through</label>
<input id="to" name="To" type="date" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" />
</div>
<button class="btn btn-outline-secondary">Apply dates</button>
<a href="/Billing">Reset</a>
</form>
<div class="panel">
<table class="table data-grid">
<thead>
<tr>
<th>Record</th>
<th>Customer</th>
<th>Service</th>
<th data-type="date">Period start</th>
<th data-type="date">Period end</th>
<th>Customer invoice state</th>
<th>Customer invoices</th>
<th>Status</th>
<th data-type="amount">Amount (RM)</th>
@if(showReceipts) { <th data-type="amount">Received (RM)</th><th data-type="amount">Outstanding (RM)</th> }
<th data-nosort>Actions</th>
</tr>
</thead>
<tbody>
@foreach(var b in Model) { var invoices=b.InvoiceLines.Where(x=>x.Invoice.Flow==InvoiceFlow.AccountingFirmToCustomer && x.Invoice.Status!=InvoiceStatus.Cancelled).Select(x=>x.Invoice).DistinctBy(x=>x.Id).ToList(); <tr>
<td>
<a href="/Billing/Details/@b.Id">B-@b.Id.ToString("D5")</a>
</td>
<td class="fw-semibold">@b.CustomerName</td>
<td>@b.ServiceName</td>
<td>@b.PeriodStart.ToString("yyyy-MM-dd")</td>
<td>@b.PeriodEnd.ToString("yyyy-MM-dd")</td>
<td><span class="badge status-@b.CustomerInvoiceState.ToString().ToLowerInvariant()">@Finance.Label(b.CustomerInvoiceState)</span></td>
<td>@(invoices.Count == 0 ? "—" : string.Join(", ", invoices.Select(x => x.InvoiceNumber)))</td>
<td>
<span class="badge status-@b.Status.ToString().ToLowerInvariant()">@Finance.Label(b.Status)</span>
</td>
<td class="money">@b.Amount.ToString("N2")</td>
@if(showReceipts) { <td class="money">@b.CustomerReceivedAmount.ToString("N2")</td><td class="money">@b.CustomerOutstandingAmount.ToString("N2")</td> }
<td><a href="/Billing/Details/@b.Id">View</a>@if(access.IsStaff && b.Status != BillingStatus.Cancelled){ <span> · </span><a href="/Billing/Edit/@b.Id">Edit</a> }</td>
</tr> }
</tbody>
</table>
</div>
