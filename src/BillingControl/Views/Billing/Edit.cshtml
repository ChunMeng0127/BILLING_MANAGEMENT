@model BillingRecordEditForm
@{ var bill = ViewBag.Bill as BillingRecord; var hasActiveInvoices = ViewBag.HasActiveInvoices == true; var hasActiveCustomerInvoices = ViewBag.HasActiveCustomerInvoices == true; var hasActiveShareInvoices = ViewBag.HasActiveShareInvoices == true; var hasActiveAssignments = ViewBag.HasActiveAssignments == true; var hasActiveReceipts = ViewBag.HasActiveReceipts == true; var hasActivePayments = ViewBag.HasActivePayments == true; var hasFinancialDependencies = hasActiveInvoices || hasActiveReceipts || hasActiveAssignments || hasActivePayments; ViewData["Title"] = "Edit billing record"; }
<a class="back-link" href="/Billing/Details/@Model.Id">← Billing details</a>
<div class="page-heading"><div><p class="eyebrow">BILLING CORRECTION</p><h1>Edit billing record</h1><p>@bill?.CustomerName · @bill?.ServiceName</p></div></div>
@if(hasFinancialDependencies) { <div class="alert alert-warning">Period changes remain locked while active downstream records exist. Customer billing amount may be corrected when the revised amount still covers active customer invoices and receipts. Revenue-share base may also be corrected: Firm / Manager / LCM shares and active worker entitlements will recalculate, but the new amounts must still cover existing Manager/LCM invoice allocations and worker payments. Existing invoice and payment history is not rewritten.</div> }
<form method="post" asp-action="Edit" class="panel form-panel wide">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="WorkItemVersion" type="hidden" />
<div class="form-grid">
<label asp-for="PeriodStart" class="form-label">Period start<input asp-for="PeriodStart" type="date" class="form-control" required /></label>
<label asp-for="PeriodEnd" class="form-label">Period end<input asp-for="PeriodEnd" type="date" class="form-control" required /></label>
<label asp-for="CustomerBillingAmount" class="form-label">Customer billing amount (RM)<input asp-for="CustomerBillingAmount" type="number" min="0.01" max="9999999999.99" step="0.01" class="form-control" required /></label>
<label asp-for="RevenueShareBaseAmount" class="form-label">Revenue-share base (RM)<input asp-for="RevenueShareBaseAmount" type="number" min="0.01" max="9999999999.99" step="0.01" class="form-control" required /><span class="hint">Changing this recalculates Firm / Manager / LCM shares and active worker entitlements using the stored percentages.</span></label>
<div>
@if(Model.Status <= BillingStatus.ReadyToBill) { <label asp-for="Status" class="form-label">Operational status</label><select asp-for="Status" class="form-select">@foreach(var status in Enum.GetValues<BillingStatus>().Where(x=>x<=BillingStatus.ReadyToBill)){<option value="@status" selected="@(status==Model.Status)">@Finance.Label(status)</option>}</select> }
else { <span class="form-label">Financial status</span><p class="form-control-plaintext">@Finance.Label(Model.Status)</p><input asp-for="Status" type="hidden" /> }
</div>
</div>
<label asp-for="Notes" class="form-label">Operational notes<textarea asp-for="Notes" rows="4" maxlength="2000" class="form-control"></textarea></label>
<p class="hint">Customer and service are immutable historical relationships. Customer billing amount may be corrected after invoicing or receipt when the revised amount still covers committed customer amounts. Revenue-share base may be corrected after downstream activity: shares and active worker entitlements recalculate from the stored percentages, while existing Manager/LCM invoice allocations and worker payments set the minimum allowed result. Existing invoice, receipt and payment history is not changed.</p>
<div class="form-actions"><button class="btn btn-primary">Save billing correction</button><a class="btn btn-outline-secondary" href="/Billing/Details/@Model.Id">Cancel</a></div>
</form>
