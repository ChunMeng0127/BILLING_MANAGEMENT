@model BillingRecord
@{ ViewData["Title"] = "B-"+Model.Id.ToString("D5"); AccessProfile access=ViewBag.Access; var cost=access.IsStaff ? Model.WorkItem.Assignments.Where(x=>!x.IsCancelled).Sum(x=>x.Entitlement) : 0m; var gross=access.IsStaff ? Model.Shares.Single(x=>x.Kind==ShareKind.Lcm).Amount : 0m; var visibleInvoices=Model.InvoiceLines.Select(x=>x.Invoice).Where(x=>access.IsStaff || (access.IsAccountingFirm && x.BusinessPartyId==access.BusinessPartyId) || (access.IsManager && x.ManagerId==access.ManagerId)).DistinctBy(x=>x.Id).ToList(); }
<a class="back-link" href="/Billing">← Billing records</a>
<div class="page-heading"><div><p class="eyebrow">@ViewData["Title"] · @Finance.Label(Model.Status)</p><h1>@Model.CustomerName</h1><p>@Model.ServiceName · @Model.PeriodStart.ToString("dd MMM yyyy") — @Model.PeriodEnd.ToString("dd MMM yyyy")</p></div>@if(access.IsStaff && Model.Status!=BillingStatus.Cancelled){<a class="btn btn-outline-secondary" href="/Billing/Edit/@Model.Id">Edit billing record</a>}
@if(access.IsStaff || access.IsManager) { <a href="/Work/Details/@Model.WorkItem.Id" class="btn btn-outline-secondary">Open work item →</a> }
</div>
<div class="metrics compact">
<div class="metric"><span>Customer billing</span><strong>RM @Model.Amount.ToString("N2")</strong></div>
@if(access.IsStaff) { @foreach(var s in Model.Shares.OrderBy(x=>x.Kind)) { <div class="metric"><span>@s.PartyName · @s.Percent.ToString("0.####")%</span><strong>RM @s.Amount.ToString("N2")</strong></div> } }
@if(access.IsAccountingFirm) { var s=Model.Shares.Single(x=>x.Kind==ShareKind.Firm); <div class="metric"><span>Your firm share · @s.Percent.ToString("0.####")%</span><strong>RM @s.Amount.ToString("N2")</strong></div> }
@if(access.IsManager) { var s=Model.Shares.Single(x=>x.Kind==ShareKind.Manager); <div class="metric"><span>Your manager share · @s.Percent.ToString("0.####")%</span><strong>RM @s.Amount.ToString("N2")</strong></div><div class="metric"><span>Work status</span><strong>@Finance.Label(Model.WorkItem.Status)</strong></div> }
</div>
<div class="panel summary-strip">
@if(access.IsStaff) { <span>Worker entitlement <strong>RM @cost.ToString("N2")</strong></span><span>LCM retained <strong>RM @((gross-cost).ToString("N2"))</strong></span> }
@if(access.IsStaff || access.IsAccountingFirm) { <span>Customer invoiced <strong>RM @Model.CustomerInvoicedAmount.ToString("N2")</strong></span><span>Customer received <strong>RM @Model.CustomerReceivedAmount.ToString("N2")</strong></span><span>Customer outstanding <strong>RM @Model.CustomerOutstandingAmount.ToString("N2")</strong></span> }
<span>Customer invoice state <strong>@Finance.Label(Model.CustomerInvoiceState)</strong></span>
</div>
@if (access.IsStaff && Model.Status <= BillingStatus.ReadyToBill) { <section class="panel form-panel wide"><h2>Update operational billing workflow</h2><p class="hint">Invoice and payment states are calculated from active invoice and receipt allocations.</p><form method="post" asp-action="Status" class="form-grid">
<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="version" value="@Model.Version" />
<div><label class="form-label" for="status">Operational status</label><select name="status" id="status" class="form-select">@foreach(var s in Enum.GetValues<BillingStatus>().Where(x=>x<=BillingStatus.ReadyToBill)) { <option value="@s" selected="@(s==Model.Status)">@Finance.Label(s)</option> }</select></div>
<div class="align-end"><button class="btn btn-primary">Save status</button></div></form></section> }
@if (access.IsStaff) { <section class="panel form-panel wide"><h2>Invoice and receipt documents</h2><p class="hint">Create invoices and allocate customer receipts through the invoice module.</p><div class="form-actions"><a class="btn btn-primary" href="/Invoices/Create">Create invoice</a><a class="btn btn-outline-secondary" href="/Invoices/Receipt">Allocate customer receipt</a></div></section> }
@if(access.IsStaff || access.IsAccountingFirm) { <section class="panel"><div class="panel-heading"><h2>Customer receipt history</h2></div><table class="table data-grid"><thead><tr><th data-type="date">Date</th><th>Reference</th><th data-type="amount">Amount (RM)</th><th>Status</th>@if(access.IsAdmin){<th data-nosort>Action</th>}</tr></thead><tbody>
@foreach(var r in Model.InvoiceLines.SelectMany(x=>x.Invoice.ReceiptAllocations).Select(x=>x.CustomerReceipt).Where(x=>x!=null).GroupBy(x=>x.Id).Select(x=>x.First())) { <tr><td>@r.ReceiptDate.ToString("yyyy-MM-dd")</td><td>@r.Reference</td><td>@r.Amount.ToString("N2")</td><td>@(r.IsCancelled ? "Cancelled: "+r.CancellationReason : "Recorded")</td>@if(access.IsAdmin){<td>@if(!r.IsCancelled) { <form asp-action="Cancel" method="post" class="inline-form"><input type="hidden" name="kind" value="receipt" /><input type="hidden" name="id" value="@r.Id" /><input name="reason" aria-label="Cancellation reason" placeholder="Cancellation reason" required class="form-control form-control-sm" /><button class="btn btn-outline-danger btn-sm">Cancel receipt</button></form> }</td>}</tr> }
</tbody></table></section> }
@if(visibleInvoices.Count > 0) { <section class="panel"><div class="panel-heading"><h2>Invoice documents</h2><a href="/Invoices">View invoice register →</a></div><table class="table data-grid"><thead><tr><th>Invoice</th><th>Flow</th><th>Date</th><th>Issuer</th><th>Recipient</th><th>Total (RM)</th><th>Status</th></tr></thead><tbody>@foreach(var i in visibleInvoices) { <tr><td><a href="/Invoices/Details/@i.Id">@i.InvoiceNumber</a></td><td>@i.Flow</td><td>@i.InvoiceDate.ToString("yyyy-MM-dd")</td><td>@i.IssuerName</td><td>@i.RecipientName</td><td class="money">@i.Total.ToString("N2")</td><td>@i.Status</td></tr> }</tbody></table></section> }
@if (access.IsAdmin && Model.Status != BillingStatus.Cancelled) { <details class="panel cancellation"><summary>Cancel billing record</summary><p>Cancel active receipts and worker assignments first. The full history is retained.</p><form method="post" asp-action="Cancel" class="inline-form"><input type="hidden" name="kind" value="billing" /><input type="hidden" name="id" value="@Model.Id" /><input name="reason" aria-label="Cancellation reason" placeholder="Reason for cancellation" required maxlength="2000" class="form-control" /><button class="btn btn-outline-danger">Cancel billing</button></form></details> }
@if(Model.Status==BillingStatus.Cancelled) { <div class="alert alert-secondary">Cancelled: @Model.CancellationReason</div> }
@if(access.IsStaff) { <p class="hint">Created @Model.CreatedAt.ToString("u") by @Model.CreatedBy · Updated @Model.UpdatedAt.ToString("u") by @Model.UpdatedBy</p> }
