@model List<BillingSchedule>
@{ ViewData["Title"] = "Upcoming billing"; }
<div class="page-heading">
<div>
<p class="eyebrow">PLAN & GENERATE</p>
<h1>Billing schedule</h1>
<p>Create one service period at a time. Generation also creates a work item.</p>
</div>
<a class="btn btn-outline-secondary" href="/Engagements">Manage engagements</a>
</div>
<div class="panel">
<table class="table data-grid">
<thead>
<tr>
<th>Customer</th>
<th>Service</th>
<th>Frequency</th>
<th data-type="date">Next start</th>
<th data-type="amount">Fee (RM)</th>
<th data-nosort>Generate billing period</th>
</tr>
</thead>
<tbody>
@foreach(var s in Model) { var e=s.Engagement; var start=s.NextPeriodStart ?? DateOnly.FromDateTime(DateTime.Today); var end=Finance.Months(s.Frequency)>0 ? Finance.Next(start,s.Frequency,s.AnchorDay).AddDays(-1) : (e.EndDate ?? start); if(e.EndDate is {} stop && end>stop) end=stop;
<tr>
<td class="fw-semibold">@e.Customer.Name</td>
<td>@e.Service.Name</td>
<td>@Finance.Label(s.Frequency)</td>
<td>@s.NextPeriodStart?.ToString("yyyy-MM-dd")</td>
<td class="money">@e.BillingAmount.ToString("N2")</td>
<td>
@if(s.NextPeriodStart != null || s.Frequency==Frequency.AdHoc) { <form method="post" asp-action="Generate" class="inline-form">
<input type="hidden" name="engagementId" value="@e.Id" />
<input type="hidden" name="advanceSchedule" value="@(s.Frequency!=Frequency.AdHoc ? "true" : "false")" />
<label>From <input name="start" type="date" value="@start.ToString("yyyy-MM-dd")" readonly="@(s.Frequency!=Frequency.AdHoc)" required class="form-control form-control-sm" />
</label>
<label>Through <input name="end" type="date" value="@end.ToString("yyyy-MM-dd")" readonly="@(s.Frequency!=Frequency.AdHoc)" required class="form-control form-control-sm" />
</label>
<button class="btn btn-primary btn-sm">Generate</button>
</form> } else { <span class="text-muted">No next period</span> }
<details class="manual-period">
<summary>Manual / replacement period</summary>
<form asp-action="Generate" method="post" class="inline-form">
<input type="hidden" name="engagementId" value="@e.Id" />
<label>From <input type="date" name="start" required class="form-control form-control-sm" />
</label>
<label>Through <input type="date" name="end" required class="form-control form-control-sm" />
</label>
<button class="btn btn-outline-secondary btn-sm">Generate manual</button>
</form>
<small>Does not advance the schedule. Active overlapping periods are rejected.</small>
</details>
</td>
</tr> }
</tbody>
</table>
</div>