@model List<Invoice>
@{ ViewData["Title"] = "Invoices"; AccessProfile access = ViewBag.Access; }
<div class="page-heading"><div><p class="eyebrow">INVOICE DOCUMENTS</p><h1>Invoices</h1><p>Issued documents and their immutable billing allocations.</p></div><div><a class="btn btn-outline-secondary" href="/Invoices/Export">Export CSV</a>@if(access.IsStaff){<a class="btn btn-outline-secondary" href="/Invoices/Receipt">Allocate customer receipt</a> <a class="btn btn-primary" href="/Invoices/Create">+ New invoice</a>}</div></div>
<div class="panel"><table class="table data-grid"><thead><tr><th>Invoice</th><th>Date</th><th>Flow</th><th>Issuer</th><th>Recipient</th><th data-type="amount">Total (RM)</th><th>Status</th><th data-nosort>Records</th></tr></thead><tbody>
@foreach(var i in Model) { <tr><td><a href="/Invoices/Details/@i.Id">@i.InvoiceNumber</a></td><td>@i.InvoiceDate.ToString("yyyy-MM-dd")</td><td>@i.Flow</td><td>@i.IssuerName</td><td>@i.RecipientName</td><td class="money">@i.Total.ToString("N2")</td><td>@i.Status</td><td>@i.Lines.Count</td></tr> }
</tbody></table></div>
