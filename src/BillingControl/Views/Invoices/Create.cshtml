@model InvoiceForm
@{ ViewData["Title"] = "New invoice"; List<BillingRecord> bills = ViewBag.Bills; }
<a class="back-link" href="/Invoices">← Invoice register</a><h1>New invoice</h1>
<form asp-action="Create" method="post" class="panel form-panel wide"><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid"><label class="form-label">Invoice number<input asp-for="InvoiceNumber" class="form-control" required /></label><label class="form-label">Invoice date<input asp-for="InvoiceDate" type="date" class="form-control" required /></label><label class="form-label">Invoice flow<select asp-for="Flow" class="form-select">@foreach(var flow in Enum.GetValues<InvoiceFlow>()){<option value="@flow">@flow</option>}</select></label></div><h2>Billing allocations</h2><p class="hint">Customer invoices require one accounting firm and one end customer. Manager invoices require one manager and firm. LCM invoices require one manager. Invoice numbers are unique for the selected issuer.</p><table class="table data-grid"><thead><tr><th>Billing</th><th>Customer</th><th>Accounting firm</th><th>Manager</th><th>Period</th><th>Amount (RM)</th><th>Allocated so far (RM)</th><th>Allocate (RM)</th></tr></thead><tbody>@foreach(var b in bills){var allocated=b.InvoiceLines.Where(x=>x.Invoice.Status!=InvoiceStatus.Cancelled).Sum(x=>x.AllocatedAmount);<tr><td>B-@b.Id.ToString("D5")</td><td>@b.CustomerName</td><td>@b.Engagement.BusinessParty.Name</td><td>@b.Engagement.Manager.Name</td><td>@b.PeriodStart — @b.PeriodEnd</td><td>@b.Amount.ToString("N2")</td><td>@allocated.ToString("N2")</td><td><input name="Allocations[@b.Id]" type="number" min="0" step="0.01" class="form-control" /></td></tr>}</tbody></table><div class="form-actions"><button class="btn btn-primary">Create invoice</button></div></form>
