@model Invoice
@{ ViewData["Title"] = Model.InvoiceNumber; AccessProfile access = ViewBag.Access; var paid = Model.ReceiptAllocations.Where(x=>!x.CustomerReceipt.IsCancelled).Sum(x=>x.Amount); }
<a class="back-link" href="/Invoices">← Invoice register</a>
<div class="page-heading"><div><p class="eyebrow">@Model.Flow · @Model.Status</p><h1>@Model.InvoiceNumber</h1><p>@Model.InvoiceDate.ToString("dd MMM yyyy") · @Model.IssuerName → @Model.RecipientName</p></div>@if(access.IsStaff && Model.Status!=InvoiceStatus.Cancelled){<a class="btn btn-outline-secondary" href="/Invoices/Edit/@Model.Id">Edit invoice</a>}</div>
<div class="metrics compact"><div class="metric"><span>Invoice total</span><strong>RM @Model.Total.ToString("N2")</strong></div>@if(Model.Flow==InvoiceFlow.AccountingFirmToCustomer && (access.IsStaff || access.IsAccountingFirm)){<div class="metric"><span>Received</span><strong>RM @paid.ToString("N2")</strong></div><div class="metric"><span>Outstanding</span><strong>RM @((Model.Total-paid).ToString("N2"))</strong></div>}</div>
<section class="panel"><div class="panel-heading"><h2>Billing allocations</h2></div><table class="table data-grid"><thead><tr><th>Billing record</th><th>Customer</th><th>Service period</th><th data-type="amount">Allocated (RM)</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td><a href="/Billing/Details/@line.BillingRecordId">B-@line.BillingRecordId.ToString("D5")</a></td><td>@line.BillingRecord.CustomerName</td><td>@line.BillingRecord.PeriodStart.ToString("yyyy-MM-dd") — @line.BillingRecord.PeriodEnd.ToString("yyyy-MM-dd")</td><td class="money">@line.AllocatedAmount.ToString("N2")</td></tr>}</tbody></table></section>
@if(Model.Flow==InvoiceFlow.AccountingFirmToCustomer && (access.IsStaff || access.IsAccountingFirm)){<section class="panel"><div class="panel-heading"><h2>Receipt allocations</h2></div><table class="table data-grid"><thead><tr><th>Date</th><th>Reference</th><th data-type="amount">Amount (RM)</th><th>Status</th></tr></thead><tbody>@foreach(var allocation in Model.ReceiptAllocations){<tr><td>@allocation.CustomerReceipt.ReceiptDate.ToString("yyyy-MM-dd")</td><td>@allocation.CustomerReceipt.Reference</td><td class="money">@allocation.Amount.ToString("N2")</td><td>@(allocation.CustomerReceipt.IsCancelled ? "Cancelled: "+allocation.CustomerReceipt.CancellationReason : "Recorded")</td></tr>}</tbody></table></section>}
@if(access.IsAdmin && Model.Status!=InvoiceStatus.Cancelled){<details class="panel cancellation"><summary>Cancel invoice</summary><p>Cancel active customer receipts before cancelling this invoice.</p><form method="post" asp-action="Cancel" class="inline-form"><input type="hidden" name="id" value="@Model.Id" /><input name="reason" aria-label="Cancellation reason" placeholder="Reason for cancellation" required maxlength="2000" class="form-control" /><button class="btn btn-outline-danger">Cancel invoice</button></form></details>}
@if(Model.Status==InvoiceStatus.Cancelled){<div class="alert alert-secondary">Cancelled: @Model.CancellationReason</div>}
<p class="hint">Created @Model.CreatedAt.ToString("u") by @Model.CreatedBy · Updated @Model.UpdatedAt.ToString("u") by @Model.UpdatedBy</p>
