@model ReceiptForm
@{ ViewData["Title"] = "Allocate customer receipt"; List<Invoice> invoices = ViewBag.Bills; }
<a class="back-link" href="/Invoices">← Invoice register</a><h1>Allocate customer receipt</h1>
<form asp-action="Receive" method="post" class="panel form-panel wide"><div asp-validation-summary="All" class="text-danger"></div><div class="form-grid"><label asp-for="ReceiptDate" class="form-label">Receipt date<input asp-for="ReceiptDate" type="date" class="form-control" required /></label><label asp-for="Reference" class="form-label">Reference<input asp-for="Reference" class="form-control" required maxlength="160" /></label><input type="hidden" asp-for="RequestId" /></div><p class="hint">Allocate one receipt across one or more active customer invoices for the same accounting firm and end customer. Each invoice's outstanding balance is enforced server-side. Posted allocation amounts are immutable; cancel a receipt and create a replacement to correct allocations.</p><table class="table data-grid"><thead><tr><th>Invoice</th><th>Accounting firm</th><th>Customer</th><th data-type="amount">Invoice total (RM)</th><th data-type="amount">Paid (RM)</th><th data-type="amount">Outstanding (RM)</th><th>Allocate (RM)</th></tr></thead><tbody>@foreach(var i in invoices){var paid=i.ReceiptAllocations.Where(x=>!x.CustomerReceipt.IsCancelled).Sum(x=>x.Amount);<tr><td><a href="/Invoices/Details/@i.Id">@i.InvoiceNumber</a></td><td>@i.IssuerName</td><td>@i.RecipientName</td><td>@i.Total.ToString("N2")</td><td>@paid.ToString("N2")</td><td>@((i.Total-paid).ToString("N2"))</td><td><input name="Allocations[@i.Id]" type="number" min="0" step="0.01" class="form-control" /></td></tr>}</tbody></table><div class="form-actions"><button class="btn btn-primary">Record receipt</button></div></form>
